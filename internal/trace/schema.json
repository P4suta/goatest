{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goatest-trace-v1",
  "title": "goatest trace event v1",
  "description": "One line of a goatest trace stream. A trace is diagnostic exhaust, never evidence, and it records environment names without their values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "type", "timestamp", "elapsed_ms"],
  "properties": {
    "seq": {
      "description": "Position of the event in the recording, counting from one.",
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "description": "Which event this is, and therefore which payload it carries.",
      "enum": [
        "run-start",
        "phase-start",
        "phase-end",
        "exec",
        "mutant-exec",
        "route",
        "probe-exec",
        "progress",
        "artifact",
        "run-end"
      ]
    },
    "schema": {
      "description": "Format identity, carried by the run-start event alone.",
      "const": "goatest-trace-v1"
    },
    "timestamp": {
      "description": "When the event was recorded, RFC 3339 in UTC.",
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "elapsed_ms": {
      "description": "Milliseconds between the start of the recording and the event.",
      "type": "integer",
      "minimum": 0
    },
    "phase": { "$ref": "#/$defs/phase" },
    "exec": { "$ref": "#/$defs/exec" },
    "mutant": { "$ref": "#/$defs/mutant" },
    "route": { "$ref": "#/$defs/route" },
    "probe": { "$ref": "#/$defs/probe" },
    "progress": { "$ref": "#/$defs/progress" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "run": { "$ref": "#/$defs/run" }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "run-start" } } },
      "then": { "required": ["schema"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "phase-start" } } },
      "then": { "required": ["phase"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "phase-end" } } },
      "then": { "required": ["phase"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "exec" } } },
      "then": { "required": ["exec"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "mutant-exec" } } },
      "then": { "required": ["mutant"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "route" } } },
      "then": { "required": ["route"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "probe-exec" } } },
      "then": { "required": ["probe"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "progress" } } },
      "then": { "required": ["progress"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "artifact" } } },
      "then": { "required": ["artifact"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "run-end" } } },
      "then": { "required": ["run"] }
    },
    {
      "if": { "required": ["schema"] },
      "then": { "properties": { "type": { "const": "run-start" } } }
    },
    {
      "if": { "required": ["phase"] },
      "then": { "properties": { "type": { "enum": ["phase-start", "phase-end"] } } }
    },
    {
      "if": { "required": ["exec"] },
      "then": { "properties": { "type": { "const": "exec" } } }
    },
    {
      "if": { "required": ["mutant"] },
      "then": { "properties": { "type": { "const": "mutant-exec" } } }
    },
    {
      "if": { "required": ["route"] },
      "then": { "properties": { "type": { "const": "route" } } }
    },
    {
      "if": { "required": ["probe"] },
      "then": { "properties": { "type": { "const": "probe-exec" } } }
    },
    {
      "if": { "required": ["progress"] },
      "then": { "properties": { "type": { "const": "progress" } } }
    },
    {
      "if": { "required": ["artifact"] },
      "then": { "properties": { "type": { "const": "artifact" } } }
    },
    {
      "if": { "required": ["run"] },
      "then": { "properties": { "type": { "const": "run-end" } } }
    }
  ],
  "$defs": {
    "phase": {
      "description": "A phase of a run. A phase is only timed when it ends.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "exec": {
      "description": "One executed command, recorded without its environment values and without its captured output.",
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "dir": { "type": "string" },
        "env_names": {
          "description": "Environment variable names alone: an item holding a value is not a trace.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^=]+$" }
        },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "timed_out": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "output_truncated": { "type": "boolean" },
        "output_path": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "mutant": {
      "description": "One mutant execution and what became of it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_id": { "type": "string" },
        "package": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "outcome": { "type": "string" },
        "killed_by": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "route": {
      "description": "How a mutant was routed to the tests that run it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "mutant_id": { "type": "string" },
        "rule": { "type": "string" },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "reaching_targets": { "type": "array", "items": { "type": "string" } },
        "plan": { "type": "array", "items": { "type": "string" } },
        "reason": { "enum": ["coverage-reaching", "unreached"] },
        "granularity": {
          "description": "Whether the reaching set was decided by the coverage blocks around the mutated position or by the file alone. Absent in a recording made before routing reported it, and present on every route that carries any of the routing metadata beside it.",
          "enum": ["block", "file"]
        },
        "fallback": {
          "description": "Why a route that would have been decided by block dropped back to the file. Absent when none did.",
          "enum": ["position-unknown", "outside-blocks"]
        },
        "file_candidates": {
          "description": "How many targets cover the mutated file at all, which is the reaching set the file alone would have selected. Absent on a route carrying a granularity means no candidate at all.",
          "type": "integer",
          "minimum": 0
        },
        "discharged": {
          "description": "The targets a proof removed from the reaching set, each with the proof that removed it: a branch the target never takes, or a mutated site the probe pass measured the target never made differ. On a route decided by block, reaching_targets and these together are the targets whose covered blocks contain the mutated position, so a discharged target is never among the reaching ones, and a proof removes a target once, so no target is discharged twice.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "reason"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "reason": { "enum": ["branch-never-taken", "never-infected"] }
            }
          }
        },
        "probed": {
          "description": "Whether the engine compiled a probe of this mutant into the probe tree, so that a measured target which does not name the mutant among its infections never made its site differ and is discharged from the reaching set. Absent in a recording made before the probe pass existed and on a mutant the engine has no probe form for.",
          "type": "boolean"
        },
        "reused": {
          "description": "Whether the run resolved this mutant from evidence an earlier run recorded instead of executing it. Nothing ran, so the recording carries no execution of the mutant and the plan is the reuse itself. Absent in a recording made before evidence was reused and on every mutant a run executed.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "required": ["fallback"] },
          "then": {
            "description": "A fallback is why a decision by block dropped back to the file, so the route that records one was decided by file.",
            "required": ["granularity"],
            "properties": { "granularity": { "const": "file" } }
          }
        },
        {
          "if": { "required": ["discharged"] },
          "then": {
            "description": "A proof removes a target from a reaching set the blocks decided, so the route that records one was decided by block.",
            "required": ["granularity"],
            "properties": { "granularity": { "const": "block" } }
          }
        },
        {
          "if": {
            "required": ["discharged"],
            "properties": {
              "discharged": {
                "contains": {
                  "required": ["reason"],
                  "properties": { "reason": { "const": "never-infected" } }
                }
              }
            }
          },
          "then": {
            "description": "The infection proof is the probe pass's measurement of this mutant, so the route that records one was probed.",
            "required": ["probed"],
            "properties": { "probed": { "const": true } }
          }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["column"] },
              { "required": ["file_candidates"] },
              { "required": ["discharged"] },
              { "required": ["probed"] }
            ]
          },
          "then": {
            "description": "The granularity is what marks a route as carrying its routing metadata, so a route carrying any of it names one.",
            "required": ["granularity"]
          }
        },
        {
          "if": { "required": ["reused"], "properties": { "reused": { "const": true } } },
          "then": {
            "description": "Nothing ran for a reused mutant, so the plan of a reused route is the reuse and nothing else.",
            "required": ["plan"],
            "properties": { "plan": { "const": ["reused"] } }
          }
        },
        {
          "if": { "required": ["plan"], "properties": { "plan": { "const": ["reused"] } } },
          "then": {
            "description": "A plan that is the reuse belongs to a route that says it was reused, so a reader is not told so by one field and not the other.",
            "required": ["reused"],
            "properties": { "reused": { "const": true } }
          }
        }
      ]
    },
    "probe": {
      "description": "One probe execution of a test target against the probe tree, recorded without the environment it ran in and without a path into that tree.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "exit_code"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "package": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "outcome": {
          "description": "What became of the execution. Absent only on one carrying the error that stopped it instead.",
          "enum": ["measured", "test-failed", "timed-out", "unavailable"]
        },
        "exit_code": { "type": "integer" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "infected": {
          "description": "The mutants whose site this target made differ from the constant the mutant would put there, by their full mutant identity, each named once. A mutant a measured target left out is one that target can never observe.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "error": {
          "description": "The error that stopped the execution before it reached an outcome.",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "description": "An execution either reached an outcome or was stopped by an error: a record saying neither describes no execution, and one saying both would be an error to one reader and a measurement to another.",
          "oneOf": [{ "required": ["outcome"] }, { "required": ["error"] }]
        },
        {
          "if": { "required": ["infected"] },
          "then": {
            "description": "Only a measured execution observed anything, so the infections it recorded come with the outcome that measured them.",
            "required": ["outcome"],
            "properties": { "outcome": { "const": "measured" } }
          }
        }
      ]
    },
    "progress": {
      "description": "A progress note forwarded from the run.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    },
    "artifact": {
      "description": "A file the run wrote.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "description": "The end of a recording, with the accounting that tells a complete trace from a lossy one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["events_emitted", "events_dropped"],
      "properties": {
        "verdict": { "type": "string" },
        "error": { "type": "string" },
        "events_emitted": { "type": "integer", "minimum": 0 },
        "events_dropped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
